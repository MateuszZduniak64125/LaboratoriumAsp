@model List<Book>
<h2>Książki</h2>
<a asp-action="Create" class="btn btn-primary mb-3">+ Dodaj książkę</a>
<table class="table">
    <thead><tr><th>Tytuł</th><th>Autor</th><th>Rok</th><th>Cena</th></tr></thead>
    <tbody>
    @foreach (var book in @Model)
    {
        <partial name="_BookRow" model="@book" />
    }
    </tbody>
</table>

@section Scripts {
    <script>
        console.log("Skrypt widoku Index (Book) został pomyślnie uruchomiony.");
    </script>
}

@section Footer {
    <span class="ms-3 text-secondary">| Sekcja Footer z widoku Index</span>
}